# Cloudflare Pages response headers.
#
# Flutter copies everything in web/ into build/web, so this file lands at the
# deployment root where Pages expects it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # ⚠️ CROSS-ORIGIN ISOLATION IS ON, AND THAT IS DELIBERATE.
  #
  # These two headers unlock Flutter's MULTI-THREADED renderer. Without them
  # everything runs on one thread, which on this site measured 32 FPS on a
  # desktop WebAssembly build — the scene is a full-screen raytraced shader,
  # so it is exactly the workload that needs the threads.
  #
  # The cost, and it is real: every cross-origin resource that does not
  # explicitly opt in is BLOCKED, and it fails silently. No embedded video, no
  # hotlinked images, no third-party fonts, no analytics — unless they are
  # self-hosted or send their own CORP header.
  #
  # This file previously argued the other way, on the grounds that a portfolio
  # is content-heavy. It turned out not to be: the site is a shader with zero
  # assets, one bundled font, and no analytics. Nothing here is cross-origin.
  #
  # ⚠️ REQUIRES `--no-web-resources-cdn` ON THE BUILD. CanvasKit is otherwise
  # fetched from gstatic.com, which COEP blocks — the app would not start.
  # See the Makefile; the flag also removes ~1.5MB of third-party download
  # from the critical path, which was worth doing regardless.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # ⚠️ EVERYTHING REVALIDATES. Do not add long-lived immutable caching here.
  #
  # Flutter's web output is NOT content-hashed: main.dart.wasm, main.dart.js,
  # flutter.js and the canvaskit files all keep the same filename forever while
  # their contents change on every build. Caching them as immutable means a
  # deploy is invisible — the browser has been told it may serve the old bytes
  # for a year and will never ask again. On the previous project exactly that
  # happened, and several deploys silently did nothing.
  #
  # must-revalidate with ETag costs one conditional request per file and gets
  # a 304 when unchanged, so the bytes are still served from cache. That is a
  # small price for a deploy actually taking effect.
  Cache-Control: public, max-age=0, must-revalidate
